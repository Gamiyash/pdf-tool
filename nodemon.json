{
    "watch": [
        "src"
    ],
    "ext": "ts,json,md",
    "ignore": [
        "src/**/*.spec.ts"
    ],
    "exec": "ts-node --transpile-only -r tsconfig-paths/register src/server.ts",
    "env": {
        "NODE_ENV": "development",
        "TS_NODE_BASEURL": "./src"
    },
    "signal": "SIGTERM"
}